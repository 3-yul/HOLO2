<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#FFFFFF">

    <!-- 상단 헤더 배경 -->

    <!-- H.O.L.O. 타이틀 -->

    <View
        android:id="@+id/view_header_background"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#F06060"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.003" />

    <TextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.05"
        android:text="H.O.L.O."
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/view_header_background"
        app:layout_constraintEnd_toStartOf="@id/button_settings"
        app:layout_constraintHorizontal_bias="0.691"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_header_background"
        app:layout_constraintVertical_bias="0.6" />

    <Button
        android:id="@+id/button_settings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/ic_settings"
        app:layout_constraintTop_toTopOf="@id/view_header_background"
        app:layout_constraintBottom_toBottomOf="@id/view_header_background"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TODO: 토글 스위치를 Switch나 SwitchCompat로 구현하는 것 고려 -->
    <!-- 중앙 토글 박스 -->

    <!-- TODO: 체크 상태 관리를 위한 StateListDrawable 사용 고려 -->
    <!-- 체크 아이콘 (토글 ON 상태 표시) -->


    <!-- TODO: 하단 영역을 별도 layout으로 분리하여 재사용성 향상 -->
    <!-- 하단 배경 웨이브 -->

    <ImageView
        android:id="@+id/image_toggle_box"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_header_background"
        app:layout_constraintVertical_bias="0.697"
        app:srcCompat="@drawable/box" />

    <ImageView
        android:id="@+id/image_toggle_box2"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_header_background"
        app:layout_constraintVertical_bias="0.394"
        app:srcCompat="@drawable/box" />

    <!-- TODO: FloatingActionButton 사용 고려 (Material Design 준수) -->
    <!-- 하단 중앙 알람 버튼 -->

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="422dp"
        android:layout_height="112dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.545"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/_2025_11_16_153612_removebg_preview" />

    <ImageView
        android:id="@+id/button_alarm"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:clickable="true"
        android:contentDescription="@string/alarm_button"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_header_background"
        app:layout_constraintVertical_bias="0.974"
        app:srcCompat="@drawable/_2025_11_16_152228_removebg_preview__1_" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="330dp"
        android:layout_height="124dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.216"
        app:srcCompat="@drawable/_2025_12_21_143910" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#00FFFFFF"
        android:text="집 안전 점검"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/image_toggle_box"
        app:layout_constraintEnd_toEndOf="@+id/image_toggle_box"
        app:layout_constraintHorizontal_bias="0.658"
        app:layout_constraintStart_toStartOf="@+id/image_toggle_box"
        app:layout_constraintTop_toTopOf="@+id/image_toggle_box"
        app:layout_constraintVertical_bias="0.495" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="건강 상태 측정"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/image_toggle_box2"
        app:layout_constraintEnd_toEndOf="@+id/image_toggle_box2"
        app:layout_constraintHorizontal_bias="0.722"
        app:layout_constraintStart_toStartOf="@+id/image_toggle_box2"
        app:layout_constraintTop_toTopOf="@+id/image_toggle_box2"
        app:layout_constraintVertical_bias="0.495" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="보호자와 연락"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="@+id/imageView"
        app:layout_constraintHorizontal_bias="0.722"
        app:layout_constraintStart_toStartOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.516" />

    <!-- TODO: 다음 기능 추가 고려 -->
    <!-- 1. 토글 애니메이션 (슬라이드 효과) -->
    <!-- 2. 알람 설정 다이얼로그 -->
    <!-- 3. 설정 화면 전환 -->
    <!-- 4. 상태 저장 (SharedPreferences) -->
    <!-- 5. 다크 모드 지원 -->

